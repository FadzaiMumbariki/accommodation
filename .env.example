# ImbaFind - Supabase Backend Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_SENTRY_ENABLED=false
# Set only when Sentry is enabled.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: Google Maps SDK Key for standalone Android builds
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: EAS Project ID for push notifications (if not using eas.json / eas project:init)
EXPO_PUBLIC_EAS_PROJECT_ID=
# Support contacts shown on the Help screen. Any channel left blank is hidden in the UI.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_HOURS=8am - 6pm CAT
# Keep SENTRY_AUTH_TOKEN out of source control.
