{
  "expo": {
    "name": "ImbaFind",
    "slug": "imbafind",
    "scheme": "imbafind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imbafind.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ImbaFind uses your camera so you can take photos of accommodation listings and upload profile pictures.",
        "NSPhotoLibraryUsageDescription": "ImbaFind accesses your photo library so you can select property photos and profile avatars.",
        "NSLocationWhenInUseUsageDescription": "ImbaFind uses your location to discover accommodation near you in Zimbabwe."
      }
    },
    "android": {
      "package": "com.imbafind.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-notifications", { "color": "#C4622D" }],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ImbaFind uses your location to discover accommodation near you in Zimbabwe."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
